{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test Rust workspace",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--workspace", "--locked"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Build release wheel",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/maturin",
      "args": ["build", "--release", "--locked", "--out", "dist"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Verify Rust and installed Python wheel (Linux)",
      "type": "process",
      "command": "bash",
      "args": ["tests/verify_release.sh"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Build optional legacy SUSY oracle (Linux/WSL)",
      "type": "process",
      "command": "bash",
      "args": ["tests/ground_truth/build_legacy.sh", "susy"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build optional legacy non-SUSY oracle (Linux/WSL)",
      "type": "process",
      "command": "bash",
      "args": ["tests/ground_truth/build_legacy.sh", "non_susy"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    }
  ]
}
