{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbifolder C++ core oracle fixture v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "variant": {
      "enum": [
        "susy",
        "non_susy"
      ]
    },
    "conventions": {
      "type": "object",
      "properties": {
        "seed": {
          "const": 0
        },
        "multiplets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 12
        },
        "factor_mapping": {
          "type": "string"
        },
        "numbers": {
          "type": "string"
        }
      },
      "required": [
        "seed",
        "multiplets",
        "factor_mapping",
        "numbers"
      ],
      "additionalProperties": false
    },
    "math": {
      "type": "object",
      "properties": {
        "rational_arithmetic": {
          "type": "object",
          "properties": {
            "a": {
              "$ref": "#/$defs/rational"
            },
            "b": {
              "$ref": "#/$defs/rational"
            },
            "sum": {
              "$ref": "#/$defs/rational"
            },
            "product": {
              "$ref": "#/$defs/rational"
            },
            "quotient": {
              "$ref": "#/$defs/rational"
            }
          },
          "required": [
            "a",
            "b",
            "sum",
            "product",
            "quotient"
          ],
          "additionalProperties": false
        },
        "parent_e8xe8_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec16"
          },
          "minItems": 480,
          "maxItems": 480
        },
        "so8_samples": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "weight": {
                    "$ref": "#/$defs/vec4"
                  },
                  "ns_r_class": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "weight",
                  "ns_r_class"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "weight": {
                    "$ref": "#/$defs/vec4"
                  },
                  "so8_s_class": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "so8_c_class": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "weight",
                  "so8_s_class",
                  "so8_c_class"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "rational_arithmetic",
        "parent_e8xe8_roots",
        "so8_samples"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "orbifold_group": {
      "$ref": "#/$defs/group"
    },
    "gauge_group": {
      "$ref": "#/$defs/gauge"
    },
    "sectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sector"
      },
      "minItems": 1
    },
    "spectrum": {
      "$ref": "#/$defs/spectrum"
    },
    "tachyonic_spectrum": {
      "$ref": "#/$defs/spectrum"
    },
    "anomalies": {
      "$ref": "#/$defs/anomalies"
    },
    "susy_analysis": {
      "$ref": "#/$defs/susy_analysis"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "massless_states": {
          "type": "string"
        },
        "tachyonic_left_solutions": {
          "type": "string"
        },
        "tachyon_search": {
          "type": "string"
        },
        "anomaly_coefficients": {
          "type": "string"
        }
      },
      "required": [
        "massless_states",
        "tachyonic_left_solutions",
        "tachyon_search",
        "anomaly_coefficients"
      ],
      "additionalProperties": false
    },
    "case_id": {
      "type": "string",
      "pattern": "^(non_)?susy_[a-z0-9_]+$"
    },
    "input": {
      "type": "object",
      "properties": {
        "model_text": {
          "type": "string"
        },
        "model_sha256": {
          "$ref": "#/$defs/hash"
        },
        "geometry_file": {
          "type": "string"
        },
        "geometry_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "model_text",
        "model_sha256",
        "geometry_file",
        "geometry_sha256"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "legacy_binary_sha256": {
          "$ref": "#/$defs/hash"
        },
        "probe_binary_sha256": {
          "$ref": "#/$defs/hash"
        },
        "cpp_sources_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/hash"
        },
        "probe_source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "build_probes_sha256": {
          "$ref": "#/$defs/hash"
        },
        "generator_sha256": {
          "$ref": "#/$defs/hash"
        },
        "comparator_sha256": {
          "$ref": "#/$defs/hash"
        },
        "schema_sha256": {
          "$ref": "#/$defs/hash"
        },
        "build_environment": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "jsonschema_version": {
          "type": "string"
        },
        "linked_inputs": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        }
      },
      "required": [
        "legacy_binary_sha256",
        "probe_binary_sha256",
        "cpp_sources_sha256",
        "source_tree_sha256",
        "probe_source_sha256",
        "build_probes_sha256",
        "generator_sha256",
        "comparator_sha256",
        "schema_sha256",
        "build_environment",
        "python_version",
        "jsonschema_version",
        "linked_inputs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "variant",
    "conventions",
    "math",
    "geometry",
    "orbifold_group",
    "gauge_group",
    "sectors",
    "spectrum",
    "tachyonic_spectrum",
    "anomalies",
    "susy_analysis",
    "coverage",
    "case_id",
    "input",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "rational": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "vec4": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "vec16": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 16,
      "maxItems": 16
    },
    "element": {
      "type": "object",
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "translation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rational"
          },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": [
        "factors",
        "translation"
      ],
      "additionalProperties": false
    },
    "excitation": {
      "type": "object",
      "properties": {
        "number_operator": {
          "type": "number"
        },
        "squared_weight_target": {
          "type": "number"
        },
        "oscillators": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "number_operator",
        "squared_weight_target",
        "oscillators"
      ],
      "additionalProperties": false
    },
    "solution": {
      "type": "object",
      "properties": {
        "excitation": {
          "$ref": "#/$defs/excitation"
        },
        "weights": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/vec4"
              },
              {
                "$ref": "#/$defs/vec16"
              }
            ]
          }
        }
      },
      "required": [
        "excitation",
        "weights"
      ],
      "additionalProperties": false
    },
    "half": {
      "type": "object",
      "properties": {
        "solution_index": {
          "type": "integer",
          "minimum": 0
        },
        "weight_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "eigenphases": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
