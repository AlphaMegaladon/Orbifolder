        "right": {
          "$ref": "#/$defs/half"
        },
        "left_solution": {
          "$ref": "#/$defs/solution"
        },
        "q_charges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vec4"
            }
          }
        },
        "oscillator_contribution": {
          "$ref": "#/$defs/vec4"
        },
        "gamma_phases": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "field_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "left",
        "right",
        "left_solution",
        "q_charges",
        "oscillator_contribution",
        "gamma_phases",
        "field_indices"
      ],
      "additionalProperties": false
    },
    "brane": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "constructing_index": {
          "type": "integer",
          "minimum": 0
        },
        "element": {
          "$ref": "#/$defs/element"
        },
        "label": {
          "type": "string"
        },
        "left_solutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/solution"
          }
        },
        "left_movers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/half"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "tachyonic_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "excited_tachyonic_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        }
      },
      "required": [
        "index",
        "constructing_index",
        "element",
        "label",
        "left_solutions",
        "left_movers",
        "states",
        "tachyonic_states",
        "excited_tachyonic_states"
      ],
      "additionalProperties": false
    },
    "sector": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "twist": {
          "$ref": "#/$defs/vec4"
        },
        "a_left": {
          "type": "number"
        },
        "a_right": {
          "type": "number"
        },
        "left_oscillators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oscillator"
          }
        },
        "right_oscillators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oscillator"
          }
        },
        "right_solutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/solution"
          }
        },
        "right_movers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/half"
          }
        },
        "tachyonic_right_solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "solution": {
                "$ref": "#/$defs/solution"
              },
              "masses": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "solution",
              "masses"
            ],
            "additionalProperties": false
          }
        },
        "tachyonic_right_movers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/half"
          }
        },
        "fixed_branes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/brane"
          },
          "minItems": 1
        }
      },
      "required": [
        "index",
        "factors",
        "twist",
        "a_left",
        "a_right",
        "left_oscillators",
        "right_oscillators",
        "right_solutions",
        "right_movers",
        "tachyonic_right_solutions",
        "tachyonic_right_movers",
        "fixed_branes"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "multiplet": {
          "type": "integer",
          "minimum": 0
        },
        "source_index": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "element": {
          "$ref": "#/$defs/element"
        },
        "weight_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "highest_weights": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "u1_charges": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "q_sh": {
          "oneOf": [
            { "$ref": "#/$defs/vec4" },
            { "type": "null" }
          ],
          "description": "Native CField value; null when unpopulated by non-SUSY legacy code. See linked state's q_charges and right solution."
        },
        "oscillator_contribution": {
          "$ref": "#/$defs/vec4"
        },
        "gamma_phases": {
          "type": "array",
          "items": {
