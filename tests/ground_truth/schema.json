          "minimum": 0
        },
        "complex_conjugate": {
          "type": "boolean"
        },
        "frequency": {
          "type": "number"
        },
        "number_operator": {
          "type": "number"
        }
      },
      "required": [
        "direction",
        "complex_conjugate",
        "frequency",
        "number_operator"
      ],
      "additionalProperties": false
