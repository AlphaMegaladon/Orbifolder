          "items": {
            "type": "string"
          }
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {
                "type": "integer"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "dimension",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "discrete_r_charges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rational"
          }
        },
        "discrete_non_r_charges": {
